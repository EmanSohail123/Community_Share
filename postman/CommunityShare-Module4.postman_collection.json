{
  "info": {
    "name": "CommunityShare Module 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "revieweeId", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "listingId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jamie Rivera\",\n  \"email\": \"jamie@example.com\",\n  \"password\": \"password123\"\n}" }, "url": "{{baseUrl}}/auth/register" } },
        { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"jamie@example.com\",\n  \"password\": \"password123\"\n}" }, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Current user", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/auth/me" } }
      ]
    },
    {
      "name": "Listings and messages",
      "item": [
        { "name": "List listings", "request": { "method": "GET", "url": "{{baseUrl}}/listings" } },
        { "name": "List conversations", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/conversations" } },
        { "name": "Message history", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/messages/{{conversationId}}" } },
        { "name": "Send message", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"receiverId\": \"{{revieweeId}}\",\n  \"conversationId\": \"{{conversationId}}\",\n  \"content\": \"Hello from Postman\"\n}" }, "url": "{{baseUrl}}/messages" } },
        { "name": "Mark messages read", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/messages/{{conversationId}}/read" } }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        { "name": "Create review", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"revieweeId\": \"{{revieweeId}}\",\n  \"listingId\": \"{{listingId}}\",\n  \"rating\": 5,\n  \"comment\": \"Great exchange\"\n}" }, "url": "{{baseUrl}}/reviews" } },
        { "name": "Reviews for user", "request": { "method": "GET", "url": "{{baseUrl}}/reviews/user/{{userId}}" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "List users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/users" } },
        { "name": "List all listings", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/listings" } },
        { "name": "Delete user", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/users/{{userId}}" } },
        { "name": "Delete listing", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/listings/{{listingId}}" } }
      ]
    }
  ]
}
